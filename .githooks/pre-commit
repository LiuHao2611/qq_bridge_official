#!/usr/bin/env bash
# ============================================================================
# 上传红线（用户 2026-11-16 要求）：任何单文件 >200KB 禁止上传。
# 在 pre-commit 拦截（比 pre-push 更早、反馈更快）。违反即 exit 1。
# 解除需用户明确要求，并改本脚本配额——不得用 --no-verify 绕过。
#
# 2026-11-16 用户授权「历史超限文件豁免」（经三轮 AskUserQuestion 确认）：
# AGENTS.md / warframe.py 在本红线设立前就已 >200KB（HEAD 分别 ~352KB / ~280KB），
# 且 warframe.py 是 6301 行、被 378 处外部引用的核心模块，强拆会破坏紫卡/市价链路。
# 红线本意是「禁止新增巨型文件」，故判据改为：
#   * 新增文件（HEAD 不存在）或 HEAD 中 ≤200KB 的文件 → 仍卡 200KB；
#   * HEAD 中本就 >200KB 的历史文件 → 豁免（仅允许其继续增长，不放开新文件）。
# 豁免名单由 git HEAD 自动判定，不硬编码文件名；新增一个 >200KB 文件仍会被拦。
# ============================================================================
set -u
LIMIT=$((200 * 1024))          # 204800 bytes
over=()
exempt=()

while IFS= read -r -d '' f; do
    # 索引里可能被删除的文件，跳过
    [ -e "$f" ] || continue
    sz=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
    [ -n "$sz" ] || continue
    if [ "$sz" -gt "$LIMIT" ]; then
        # HEAD 中本就超限的历史文件 → 豁免（用户 2026-11-16 授权）
        head_sz=$(git cat-file -s "HEAD:$f" 2>/dev/null || echo 0)
        if [ "${head_sz:-0}" -gt "$LIMIT" ]; then
            exempt+=("$(printf '%8d B→%8d B  %s（HEAD 已超限·豁免）' "$head_sz" "$sz" "$f")")
            continue
        fi
        over+=("$(printf '%8d B  %s' "$sz" "$f")")
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "${#exempt[@]}" -gt 0 ]; then
    echo "────────────────────────────────────────────────────────────" >&2
    echo "ℹ 历史超限文件豁免（用户授权；HEAD 中本就 >200KB）:" >&2
    printf '   %s\n' "${exempt[@]}" >&2
fi

if [ "${#over[@]}" -gt 0 ]; then
    echo "════════════════════════════════════════════════════════════" >&2
    echo "⛔ 上传红线：以下文件 >200KB，禁止提交（单文件上限 $((LIMIT)) B）" >&2
    printf '   %s\n' "${over[@]}" >&2
    echo "   请拆分为小文件 / 放进 .gitignore / 或改用外部资产库。" >&2
    echo "   本红线由 .githooks/pre-commit 拦截，禁止 --no-verify 绕过。" >&2
    echo "════════════════════════════════════════════════════════════" >&2
    exit 1
fi
exit 0
